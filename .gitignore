# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only - bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json
# Exception: the AI-governance action's prompt template is not a secret, but the
# rule above matches it by basename. Keep it tracked -- the action needs it at runtime.
!.github/actions/ai-governance/config.json

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# Design / planning docs (README must stay tracked, including the English version)
*.md
!README.md
!README.en.md
